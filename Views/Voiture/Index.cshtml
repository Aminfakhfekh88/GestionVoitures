@model IEnumerable<GestionVoitures.Models.Voiture>

@{
    ViewData["Title"] = "Liste des Voitures";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Catalogue des Voitures Disponibles</h2>
    <a asp-action="Create" class="btn btn-primary">+ Ajouter une voiture</a>
</div>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Marque</th>
            <th>Modèle</th>
            <th>Année</th>
            <th>Prix / Jour</th>
            <th>Disponibilité</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td><strong>@item.Marque</strong></td>
                <td>@item.Modele</td>
                <td>@item.Annee</td>
                <td>@item.PrixJour.ToString("F2") DT</td>
                <td>
                    @if (item.EstDisponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Louée</span>
                    }
                </td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">Modifier</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>