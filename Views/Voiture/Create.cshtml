@model GestionVoitures.Models.Voiture

@{
    ViewData["Title"] = "Ajouter une voiture";
}

<h2>Ajouter une nouvelle voiture</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Marque" class="form-label">Marque :</label>
                <input asp-for="Marque" class="form-control" required placeholder="Ex: Hyundai" />
            </div>

            <div class="mb-3">
                <label asp-for="Modele" class="form-label">Modèle :</label>
                <input asp-for="Modele" class="form-control" required placeholder="Ex: i20" />
            </div>

            <div class="mb-3">
                <label asp-for="Annee" class="form-label">Année :</label>
                <input asp-for="Annee" type="number" class="form-control" value="2024" required />
            </div>

            <div class="mb-3">
                <label asp-for="PrixJour" class="form-label">Tarif Journalier en Dinars (DT) :</label>
                <input asp-for="PrixJour" type="number" step="0.01" class="form-control" required />
            </div>

            <div class="form-check mb-4">
                <input asp-for="EstDisponible" class="form-check-input" type="checkbox" checked />
                <label asp-for="EstDisponible" class="form-check-label">Véhicule disponible immédiatement</label>
            </div>

            <button type="submit" class="btn btn-success">Enregistrer la voiture</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Annuler</a>
        </form>
    </div>
</div>