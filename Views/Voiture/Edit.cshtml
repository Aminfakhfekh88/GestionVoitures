@model GestionVoitures.Models.Voiture

@{
    ViewData["Title"] = "Modifier une voiture";
}

<h2>Modifier la voiture #@Model.Id</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <!-- Champ caché pour transmettre l'ID de la voiture au contrôleur -->
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Marque" class="form-label">Marque :</label>
                <input asp-for="Marque" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Modele" class="form-label">Modèle :</label>
                <input asp-for="Modele" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Annee" class="form-label">Année :</label>
                <input asp-for="Annee" type="number" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="PrixJour" class="form-label">Tarif Journalier (DT) :</label>
                <input asp-for="PrixJour" type="number" step="0.01" class="form-control" required />
            </div>

            <div class="form-check mb-4">
                <input asp-for="EstDisponible" class="form-check-input" type="checkbox" />
                <label asp-for="EstDisponible" class="form-check-label">Disponible</label>
            </div>

            <button type="submit" class="btn btn-warning">Mettre à jour</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Retour à la liste</a>
        </form>
    </div>
</div>